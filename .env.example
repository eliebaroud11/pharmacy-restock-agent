# Copy this file to .env and fill in ONE key. .env is git-ignored.
# Easiest: run  powershell -ExecutionPolicy Bypass -File .\scripts\set_key.ps1

# Option A - Claude (Anthropic): console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
# Option B - OpenRouter (has free models): openrouter.ai -> Keys
OPENROUTER_API_KEY=

# anthropic | openrouter. Leave empty to pick automatically from the key you set.
PHARMA_PROVIDER=
# Model that reads invoices. Empty = default for the provider:
#   anthropic:  claude-opus-5-5  (or claude-sonnet-5-5, claude-haiku-5-5)
#   openrouter: nvidia/nemotron-3.5-super-vl:free  (any OpenRouter vision model id)
# Recommended (fast, ~5 s and < $0.001 per invoice; needs OpenRouter credit): anthropic/claude-haiku-5.5
PHARMA_MODEL=
# Model for the follow-up agent (empty = same as PHARMA_MODEL)
PHARMA_AGENT_MODEL=
# Claude only: low | medium | high
PHARMA_EFFORT=medium

# 1 = show the "Reset demo data" button (wipes everything, audit log included). Leave empty in a real pharmacy.
PHARMA_DEMO=

# Alert thresholds
NEAR_EXPIRY_DAYS=90
