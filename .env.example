# Copy this file to .env and fill in your key. .env is git-ignored.
ANTHROPIC_API_KEY=sk-ant-...

# Model used to read invoices. Options: claude-opus-5-5 (default), claude-sonnet-5-5, claude-haiku-5-5
PHARMA_MODEL=claude-opus-5-5
# low | medium | high
PHARMA_EFFORT=medium

# Alert thresholds
NEAR_EXPIRY_DAYS=90
